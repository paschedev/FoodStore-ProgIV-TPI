# Conexión a PostgreSQL (para desarrollo también se acepta sqlite:///./foodstore.db)
DATABASE_URL=postgresql+psycopg2://postgres:CAMBIAR_PASSWORD@localhost:5432/foodstore_db
# Firma del JWT: al menos 32 caracteres
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_ORIGIN=http://localhost:5173
